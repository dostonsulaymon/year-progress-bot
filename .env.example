# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numeric ID of the channel the countdown is posted to.
# Channels/supergroups are negative and start with -100.
CHANNEL_ID=-1001234567890

# Comma-separated Telegram user IDs allowed to run bot commands.
# Get your own ID from @userinfobot. If this is empty, all commands are refused.
ADMIN_IDS=111111111,222222222
